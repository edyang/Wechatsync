# The install script generates actual random 256-bit tokens on first run.
# The two tokens MUST be different; never check the real .env into Git.
WECHATSYNC_TOKEN=REPLACE_WITH_RANDOM_64_HEX_BRIDGE_TOKEN
WECHATSYNC_HTTP_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX_MANAGER_TOKEN

# Only the host loopback is published by Docker. Chrome running on the
# same host connects to ws://127.0.0.1:9527.
WS_BIND_IP=127.0.0.1
WS_HOST_PORT=9527
MCP_BIND_IP=127.0.0.1
MCP_HOST_PORT=9528

# Inside the container the services bind 0.0.0.0; only published host
# ports are loopback. The internal 9529 bridge is NEVER published.
