# Example only: installer creates /etc/wechatsync-mcp/.env with random tokens.
# Never commit real values. Edit the installed file with sudoedit, then restart.
WECHATSYNC_TOKEN=REPLACE_WITH_64_HEX_CHARACTERS
WECHATSYNC_HTTP_TOKEN=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS

# Secure defaults. For Chrome on a separate PC, use an SSH port-forward.
SYNC_WS_HOST=127.0.0.1
SYNC_WS_PORT=9527
# For Manager in Docker/another host, use a private reverse proxy or VPN.
SYNC_HTTP_HOST=127.0.0.1
SYNC_HTTP_PORT=9528
# Internal local bridge. Never expose port 9529 externally.
SYNC_BRIDGE_API_PORT=9529
